# Copy to .env and fill in. .env is gitignored; this file is not.
#
# Both values are public by design: the anon key ships in the website's bundle
# already and grants nothing on its own, because row-level security decides
# what any request can touch. They live here rather than in the repo so the
# codebase carries no keys at all.
#
# Find them in Vercel: Settings, Environment Variables, VITE_SUPABASE_URL and
# VITE_SUPABASE_ANON_KEY. Same values, different prefix.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
